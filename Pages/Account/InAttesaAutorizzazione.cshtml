@page
@model TimeFlow.Pages.Account.InAttesaAutorizzazioneModel
@{
    ViewData["Title"] = "In attesa di autorizzazione";
}

<div class="text-center">
    <h1 class="mb-4">Richiesta di accesso inviata</h1>
    <p>Il tuo account è stato registrato ma è in attesa di autorizzazione da parte di un amministratore.</p>
