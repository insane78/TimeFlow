@page "{anno:int?}/{mese:int?}"
@model TimeFlow.Pages.Timesheet.IndexModel
@{
    ViewData["Title"] = "Timesheet";
    ViewData["FullPage"] = true;
}

@{
    var mesePrecedente = new DateOnly(Model.Anno, Model.Mese, 1).AddMonths(-1);
    var meseSuccessivo = new DateOnly(Model.Anno, Model.Mese, 1).AddMonths(1);
}

<div class="tf-timesheet-wrapper">
    <div class="d-flex align-items-center justify-content-center gap-3 mb-3">
        <a class="btn btn-outline-primary btn-sm tf-navigazione-mese" asp-page="./Index" asp-route-anno="@mesePrecedente.Year" asp-route-mese="@mesePrecedente.Month">&laquo;</a>
        <input type="month" id="tf-selettore-mese" class="form-control form-control-lg fw-bold text-center w-auto tf-selettore-mese"
               value="@($"{Model.Anno:0000}-{Model.Mese:00}")" />
        <a class="btn btn-outline-primary btn-sm tf-navigazione-mese" asp-page="./Index" asp-route-anno="@meseSuccessivo.Year" asp-route-mese="@meseSuccessivo.Month">&raquo;</a>
    </div>

    @Html.AntiForgeryToken()

    <div id="timesheet-grid"></div>
</div>

<div class="modal fade" id="tf-modal-esporta-cliente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Esporta per cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="tf-esporta-cliente-select" class="form-label">Cliente</label>
                    <select id="tf-esporta-cliente-select" class="form-select"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label d-block">Periodo</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="tf-esporta-cliente-periodo" id="tf-esporta-cliente-mese" value="mese">
                        <label class="form-check-label" for="tf-esporta-cliente-mese">Timesheet corrente (mese)</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="tf-esporta-cliente-periodo" id="tf-esporta-cliente-anno" value="anno" checked>
                        <label class="form-check-label" for="tf-esporta-cliente-anno">Anno corrente</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="btn btn-primary" id="tf-esporta-cliente-conferma">Esporta</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="tf-modal-rapporto-progetti" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Rapporto giorni per progetto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label d-block mb-2">Modalità</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="tf-rapporto-modalita" id="tf-rapporto-modalita-periodo" value="periodo" checked>
                        <label class="form-check-label" for="tf-rapporto-modalita-periodo">Periodo</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="tf-rapporto-modalita" id="tf-rapporto-modalita-attivita" value="attivita">
                        <label class="form-check-label" for="tf-rapporto-modalita-attivita">Cliente/Progetto/Attività (storico fino a oggi)</label>
                    </div>
                </div>
                <div class="row g-3 align-items-end" id="tf-rapporto-sezione-periodo">
                    <div class="col-md-6">
                        <label for="tf-rapporto-inizio" class="form-label">Da (mese/anno)</label>
                        <input type="month" id="tf-rapporto-inizio" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label for="tf-rapporto-fine" class="form-label">A (mese/anno)</label>
                        <input type="month" id="tf-rapporto-fine" class="form-control" />
                    </div>
                </div>
                <div class="row g-3 align-items-end d-none mt-0" id="tf-rapporto-sezione-attivita">
                    <div class="col-md-4">
                        <label for="tf-rapporto-cliente" class="form-label">Cliente</label>
                        <select id="tf-rapporto-cliente" class="form-select"></select>
                    </div>
                    <div class="col-md-4">
                        <label for="tf-rapporto-progetto" class="form-label">Progetto</label>
                        <select id="tf-rapporto-progetto" class="form-select"></select>
                    </div>
                    <div class="col-md-4">
                        <label for="tf-rapporto-attivita" class="form-label">Attività (opzionale)</label>
                        <select id="tf-rapporto-attivita" class="form-select"></select>
                    </div>
                </div>
                <div class="mt-3">
                    <button type="button" class="btn btn-primary" id="tf-rapporto-calcola">Calcola</button>
                </div>
                <div class="mt-3 d-none" id="tf-rapporto-errore"></div>
                <div class="table-responsive mt-3">
                    <table class="table table-sm table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th>Progetto</th>
                                <th class="text-end">Totale ore</th>
                                <th class="text-end">Totale giorni</th>
                            </tr>
                        </thead>
                        <tbody id="tf-rapporto-righe">
                            <tr>
                                <td colspan="4" class="text-center text-muted">Seleziona i parametri e premi Calcola.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Chiudi</button>
            </div>
        </div>
    </div>
</div>

@{
    var opzioniJson = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
}

@section Scripts {
    <script>
        window.tfTimesheetData = {
            anno: @Model.Anno,
            mese: @Model.Mese,
            giorniNelMese: @Model.GiorniNelMese,
            compensoGiornaliero: @(Model.CompensoGiornaliero.HasValue ? Model.CompensoGiornaliero.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null"),
            giorni: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Giorni, opzioniJson)),
            righe: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Righe, opzioniJson)),
            clienti: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Clienti, opzioniJson)),
            salvaCellaUrl: '@Url.Page("./Index", "SalvaCella")',
            aggiornaRigaUrl: '@Url.Page("./Index", "AggiornaRiga")',
            esportaMeseUrl: '@Url.Page("./Index", "EsportaMese", new { anno = Model.Anno, mese = Model.Mese })',
            esportaClienteUrlBase: '@Url.Page("./Index", "EsportaCliente")',
            rapportoGiorniProgettoUrlBase: '@Url.Page("./Index", "RapportoGiorniProgetto")',
            rapportoAttivitaStoricoUrlBase: '@Url.Page("./Index", "RapportoAttivitaStorico")'
        };
    </script>
    <script src="~/js/timesheet.js" asp-append-version="true"></script>
    <script>
        (function () {
            document.querySelectorAll('.tf-navigazione-mese').forEach(function (link) {
                link.addEventListener('click', function (event) {
                    if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
                    event.preventDefault();
                    window.tfNavigaMese(link.href);
                });
            });
            var selettore = document.getElementById('tf-selettore-mese');
            if (!selettore) return;
            selettore.addEventListener('mousedown', function (event) {
                event.preventDefault();
                if (typeof selettore.showPicker === 'function') {
                    selettore.showPicker();
                } else {
                    selettore.focus();
                }
            });
            selettore.addEventListener('change', function () {
                if (!selettore.value) return;
                var parti = selettore.value.split('-');
                var anno = parseInt(parti[0], 10);
                var mese = parseInt(parti[1], 10);
                window.tfNavigaMese('@Url.Page("./Index", new { anno = (string)null, mese = (string)null })' + '/' + anno + '/' + mese);
            });
        })();
    </script>
}
