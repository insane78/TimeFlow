@using Microsoft.AspNetCore.Identity
@using TimeFlow.Models
@inject UserManager<Utente> UserManager
@{
    var fullPage = ViewData["FullPage"] is true;
    var isAdmin = false;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var utenteCorrente = await UserManager.GetUserAsync(User);
        isAdmin = utenteCorrente?.Admin ?? false;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TimeFlow</title>
    <link rel="icon" type="image/x-icon" href="~/images/favicon.ico" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TimeFlow.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(fullPage ? "tf-full-page" : null)">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <img src="~/images/timeflow-logo.png" alt="TimeFlow" height="48" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">
                                <svg class="tf-nav-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1.06 15.5 8H14v6.5a.5.5 0 0 1-.5.5H10v-4.5A1.5 1.5 0 0 0 8.5 9h-1A1.5 1.5 0 0 0 6 10.5V15H2.5a.5.5 0 0 1-.5-.5V8H.5L8 1.06Z"/></svg>
                                Home
                            </a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Timesheet/Index">
                                    <svg class="tf-nav-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5Z"/><path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16Zm0-1A7 7 0 1 1 8 1a7 7 0 0 1 0 14Z"/></svg>
                                    Timesheet
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Clienti/Index">
                                    <svg class="tf-nav-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M15 14s1 0 1-1-1-4-6-4-6 3-6 4 1 1 1 1h10Zm-9.995-.944v-.002.002ZM5.021 13h9.958a.274.274 0 0 0 .014-.002 1.13 1.13 0 0 0-.045-.263c-.162-.505-.607-1.31-1.52-2.05C12.601 9.98 11.245 9.5 10 9.5c-1.245 0-2.601.48-3.428 1.185-.913.74-1.358 1.545-1.52 2.05a1.13 1.13 0 0 0-.045.263c.005 0 .01.002.014.002Zm4.98-6.006A2.5 2.5 0 1 0 10 2.5a2.5 2.5 0 0 0 0 4.994Zm0 1a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7ZM1 14s-1 0-1-1 1-4 6-4c.35 0 .68.021.99.06C6.276 9.629 5.5 10.556 5.5 11.5c0 .95.755 1.858 1.964 2.5H1Zm3.75-8.75a2.5 2.5 0 1 1 5 0 2.5 2.5 0 0 1-5 0Zm2.5-3.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z"/></svg>
                                    Clienti
                                </a>
                            </li>
                            @if (isAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/Admin/Utenti/Index">
                                        <svg class="tf-nav-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872l-.1-.34ZM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858Z"/></svg>
                                        Gestione utenti
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link"><span class="tf-user-badge">@User.Identity.Name</span></span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Account/Logout">
                                    <svg class="tf-nav-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M6 12.5a.5.5 0 0 0 .5.5h8a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 0-.5-.5h-8a.5.5 0 0 0-.5.5v2a.5.5 0 0 1-1 0v-2A1.5 1.5 0 0 1 6.5 2h8A1.5 1.5 0 0 1 16 3.5v9a1.5 1.5 0 0 1-1.5 1.5h-8A1.5 1.5 0 0 1 5 12.5v-2a.5.5 0 0 1 1 0v2Z"/><path fill-rule="evenodd" d="M.146 8.354a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L1.707 7.5H10.5a.5.5 0 0 1 0 1H1.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3Z"/></svg>
                                    Esci
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn-ms-signin" asp-page="/Account/Login" asp-page-handler="Microsoft">
                                    <span class="ms-logo" aria-hidden="true">
                                        <span></span><span></span><span></span><span></span>
                                    </span>
                                    <span>Sign in with Microsoft</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="@(fullPage ? "container-fluid tf-page-content" : "container")">
        <main role="main" class="@(fullPage ? "tf-page-main" : "pb-3")">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
