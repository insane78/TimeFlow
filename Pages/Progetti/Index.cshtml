@page "{clienteId:int}"
@model TimeFlow.Pages.Progetti.IndexModel
@{
    ViewData["Title"] = "Progetti";
}

<h1>Progetti di @Model.Cliente.Nome</h1>

<p>
    <a class="btn btn-primary" asp-page="./Create" asp-route-clienteId="@Model.Cliente.Id">Nuovo progetto</a>
    <a class="btn btn-secondary" asp-page="/Clienti/Index">Torna ai clienti</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Attivo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var progetto in Model.Progetti)
        {
            <tr>
                <td>@progetto.Nome</td>
                <td>@(progetto.Attivo ? "Sì" : "No")</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-page="/Attivita/Index" asp-route-progettoId="@progetto.Id">Attività</a>
                    <a class="btn btn-sm btn-secondary" asp-page="./Edit" asp-route-id="@progetto.Id">Modifica</a>
                    <a class="btn btn-sm btn-danger" asp-page="./Delete" asp-route-id="@progetto.Id">Elimina</a>
                </td>
            </tr>
        }
    </tbody>
</table>
