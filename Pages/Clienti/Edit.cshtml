@page "{id:int}"
@model TimeFlow.Pages.Clienti.EditModel
@{
    ViewData["Title"] = "Modifica cliente";
}

<h1>Modifica cliente</h1>

<form method="post">
    <input type="hidden" asp-for="Cliente.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Cliente.Nome" class="form-label"></label>
        <input asp-for="Cliente.Nome" class="form-control" />
        <span asp-validation-for="Cliente.Nome" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Cliente.Attivo" class="form-check-input" />
        <label asp-for="Cliente.Attivo" class="form-check-label"></label>
    </div>
    <div class="mb-3">
        <label asp-for="Cliente.Colore" class="form-label"></label>
        <input asp-for="Cliente.Colore" type="color" class="form-control form-control-color" />
        <span asp-validation-for="Cliente.Colore" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Salva</button>
    <a class="btn btn-secondary" asp-page="./Index">Annulla</a>
</form>
